// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../Backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Products will belong to exactly one category. The API module can be added
// later without changing this relationship or migrating existing categories.
model Product {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  categoryId     Int
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           String
  buyPrice       Int
  sellPrice      Int
  stock          Int            @default(0)
  minStock       Int            @default(0)
  description    String?
  isActive       Boolean        @default(true)
  priceHistories PriceHistory[]
  auditLogs      AuditLog[]
  inventoryTransactions InventoryTransaction[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Buyer {
  id         Int       @id @default(autoincrement())
  firstName  String
  lastName   String
  nationalId String?   @unique
  phone      String?
  address    String?
  notes      String?
  invoices   Invoice[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lastName, firstName])
}

enum PriceChangeType {
  SINGLE
  BULK
}

model PriceHistory {
  id            Int             @id @default(autoincrement())
  productId     Int
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  oldBuyPrice   Int?
  newBuyPrice   Int?
  oldSellPrice  Int?
  newSellPrice  Int?
  changePercent Float?
  type          PriceChangeType
  changedById   Int?
  changedByName String?
  createdAt     DateTime        @default(now())

  @@index([productId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

model InventoryTransaction {
  id          Int                      @id @default(autoincrement())
  productId   Int
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        InventoryTransactionType
  quantity    Int
  unitPrice   Int?
  description String?
  invoiceId   Int?
  invoice     Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())
  currency    String                   @default("TOMAN")

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model Invoice {
  id             Int                      @id @default(autoincrement())
  number         String                   @unique @default(uuid())
  buyerFirstName String?
  buyerLastName  String?
  buyerNationalId String?
  buyerAddress   String?
  buyerPhone     String?
  customerId     Int?
  customer       Buyer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes          String?
  total          Int
  subtotal       Int                      @default(0)
  discount       Int                      @default(0)
  paidAmount     Int                      @default(0)
  settlement     String                   @default("CASH")
  currency       String                   @default("IRR")
  issueDate      DateTime                 @default(now()) @db.Date
  sellerName     String?
  sellerAddress  String?
  sellerPhone    String?
  sellerLogoUrl  String?
  sellerIban     String?
  items          InvoiceItem[]
  transactions   InventoryTransaction[]
  createdAt      DateTime                 @default(now())

  @@index([customerId, createdAt])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  unit      String
  quantity  Int
  unitPrice Int
  total     Int
}

model StoreSettings {
  id        Int      @id @default(1)
  name      String   @default("فروشگاه")
  address   String   @default("")
  phone     String   @default("")
  logoUrl   String?
  iban      String   @default("")
  defaultInvoiceNotes String @default("")
  updatedAt DateTime @updatedAt
}
